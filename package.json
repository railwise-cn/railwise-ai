{
  "name": "workwise",
  "productName": "RailWise AI",
  "version": "0.5.3",
  "description": "AI workbench for engineering, infrastructure, and operations workflows",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:electron && npm run build:runtime && electron-vite dev",
    "build": "npm run build:runtime && electron-vite build",
    "build:runtime": "node ./scripts/ensure-runtime-install.cjs && npm --prefix kun run build",
    "build:markitdown-sidecar": "node ./scripts/build-markitdown-sidecar.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:survey-converter-sandbox": "npm --prefix kun run test:survey-converter-sandbox",
    "test:watch": "vitest",
    "test:stability": "node ./scripts/stability-cycle.mjs",
    "test:release-gate": "node --test ./scripts/release-gate.test.mjs",
    "test:managed-tools:live": "node ./scripts/run-managed-tool-live-test.cjs",
    "openspec": "openspec",
    "openspec:validate": "openspec validate --all --strict --no-interactive",
    "openspec:status": "openspec list",
    "verify:brand-boundary": "node ./scripts/verify-brand-boundary.mjs",
    "verify:build-freshness": "node ./scripts/verify-build-freshness.cjs",
    "verify:document-licenses": "node ./scripts/verify-document-dependencies.mjs",
    "generate:specialist-skill-audit": "node ./scripts/specialist-skill-audit.cjs --write",
    "verify:specialist-skills": "node ./scripts/specialist-skill-audit.cjs",
    "dist": "npm run build && npx --yes electron-builder@26.8.1 --config electron-builder.cjs --publish never",
    "dist:mac": "rm -f dist/WorkWise-*-mac-* dist/latest-mac.yml && npm run build && npm run dist:mac:x64:artifacts && npm run dist:mac:arm64:artifacts",
    "dist:mac:signed": "rm -f dist/WorkWise-*-mac-* dist/latest-mac.yml && npm run build && MAC_SIGN=1 node ./scripts/run-mac-artifact-build-with-retry.mjs x64 && MAC_SIGN=1 node ./scripts/run-mac-artifact-build-with-retry.mjs arm64",
    "dist:mac:arm64": "npm run build && npm run dist:mac:arm64:artifacts",
    "dist:mac:x64": "npm run build && npm run dist:mac:x64:artifacts",
    "dist:mac:arm64:artifacts": "npm run dist:mac:arm64:dmg && node ./scripts/zip-mac-app.cjs arm64",
    "dist:mac:x64:artifacts": "npm run dist:mac:x64:dmg && node ./scripts/zip-mac-app.cjs x64",
    "dist:mac:arm64:dmg": "node ./scripts/verify-build-freshness.cjs && WORKWISE_SIDECAR_ARCH=arm64 npx --yes electron-builder@26.8.1 --config electron-builder.cjs --publish never --mac dmg --arm64",
    "dist:mac:x64:dmg": "node ./scripts/verify-build-freshness.cjs && WORKWISE_SIDECAR_ARCH=x64 npx --yes electron-builder@26.8.1 --config electron-builder.cjs --publish never --mac dmg --x64",
    "dist:win": "npm run dist -- --win nsis --x64",
    "release:all": "bash ./scripts/release-mac.sh",
    "release:mac": "bash ./scripts/release-mac.sh",
    "release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-win.ps1",
    "prepare:converters": "node ./scripts/prepare-markdown-converters.cjs",
    "prepare:electron": "node ./scripts/ensure-electron-install.cjs",
    "r2:upload": "node ./scripts/publish-r2.mjs upload",
    "r2:verify": "node ./scripts/publish-r2.mjs verify",
    "r2:promote": "node ./scripts/publish-r2.mjs promote",
    "r2:rollback": "node ./scripts/publish-r2.mjs rollback",
    "postinstall": "node ./scripts/postinstall.cjs",
    "verify:apple": "node ./scripts/verify-apple-signing.cjs",
    "verify:mac-release-artifacts": "node ./scripts/verify-mac-release-artifacts.cjs",
    "verify:release-assets": "node ./scripts/verify-release-assets.cjs",
    "verify:packaged-asar": "node ./scripts/verify-packaged-asar.cjs",
    "verify:packaged-runtime-native": "node ./scripts/verify-packaged-runtime-native.cjs",
    "verify:ppt-master-sidecar": "node ./scripts/verify-ppt-master-sidecar.cjs",
    "preview": "npm run prepare:electron && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "mac:unquarantine": "bash ./scripts/mac-unquarantine.sh",
    "generate:icons": "node ./scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1049.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@smithy/node-http-handler": "4.7.6",
    "@tencent-weixin/openclaw-weixin": "2.4.3",
    "@xyflow/react": "^12.11.2",
    "axios": "^1.16.0",
    "better-sqlite3": "^12.11.1",
    "bindings": "^1.5.0",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.9",
    "file-uri-to-path": "^1.0.0",
    "highlight.js": "^11.11.1",
    "i18next": "^25.4.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.544.0",
    "markdown-it": "^14.2.0",
    "openclaw": "file:vendor/openclaw-shim",
    "pdfjs-dist": "5.4.624",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.7.4",
    "react-markdown": "^10.1.0",
    "rehype-harden": "^1.1.8",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "streamdown": "^2.5.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.0",
    "@electron/rebuild": "4.0.3",
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "1.6.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^43.1.1",
    "electron-vite": "^3.1.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.2.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "body-parser": "^2.3.0",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "hono": "4.13.1",
    "@hono/node-server": "2.1.0",
    "dompurify": "3.4.13",
    "ip-address": "10.5.0",
    "docx": {
      "nanoid": "5.1.16"
    },
    "postcss": {
      "nanoid": "3.3.18"
    },
    "streamdown": {
      "mermaid": "11.16.1"
    },
    "mermaid": {
      "dompurify": "3.4.13"
    }
  },
  "author": "WorkWise Contributors",
  "homepage": "https://github.com/railwise-cn/railwise-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/railwise-cn/railwise-ai.git"
  }
}
